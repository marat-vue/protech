enum ObtainingMethod {
    DELIVERY
    PICKUP
}

enum OrderStatus {
    NEW
    CONFIRMED
    PROCESSING
    SHIPPED
    COMPLETED
    PAYMENT_REVIEW
    CANCELLED
}

enum PaymentMethod {
    OFFLINE
    ONLINE
}

model Order {
    id              Int             @id @default(autoincrement())
    userId          String?         @map("user_id")
    user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
    obtainingMethod ObtainingMethod @map("obtaining_method")
    orderStatus     OrderStatus     @default(NEW) @map("order_status")
    paymentMethod   PaymentMethod   @map("payment_method")
    customerPhone   String?         @map("customer_phone")
    recipientName   String?         @map("recipient_name")
    recipientPhone  String?         @map("recipient_phone")
    stockReserved   Boolean         @default(false) @map("stock_reserved")
    idempotencyKey  String?         @unique @map("idempotency_key") @db.VarChar(128)
    requestFingerprint String?      @map("request_fingerprint") @db.VarChar(64)
    promoCodeId          Int?       @map("promo_code_id")
    promoCode            PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
    promoCodeText        String?    @map("promo_code") @db.VarChar(64)
    promoDiscountPercent Int        @default(0) @map("promo_discount_percent")
    subtotalAmount       Decimal    @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
    discountAmount       Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    orderItems OrderItem[]
    delivery   Delivery?
    payment    Payment?
    stockMovements StockMovement[]

    @@index([userId])
    @@index([promoCodeId])
    @@index([orderStatus, createdAt])
    @@index([createdAt])
    @@map("order")
}

model OrderItem {
    id               Int      @id @default(autoincrement())
    orderId          Int      @map("order_id")
    order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    productId        Int      @map("product_id")
    product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
    price            Decimal  @db.Decimal(12, 2)
    costPrice        Decimal? @map("cost_price") @db.Decimal(12, 2)
    lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
    quantity         Int
    productName      String   @map("product_name")
    productArticle   String   @map("product_article")
    productMainImage String?  @map("product_main_image")
    categoryId       Int?     @map("category_id")
    categoryName     String?  @map("category_name")

    @@unique([orderId, productId])
    @@index([productId])
    @@index([categoryId])
    @@map("order_item")
}

enum DeliveryMethod {
    OZON
    CDEK
}

model Delivery {
    id             Int            @id @default(autoincrement())
    orderId        Int            @unique @map("order_id")
    order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
    address        String
    apartment      String?
    entrance       String?
    floor          String?
    intercom       String?
    comment        String?
    deliveryMethod DeliveryMethod @default(OZON) @map("delivery_method")

    deliveredAt DateTime? @map("delivered_at")

    @@index([orderId])
    @@map("delivery")
}

enum PaymentStatus {
    PENDING
    UPON_RECEIPT
    PAID
    PARTIALLY_REFUNDED
    REFUNDED
    CANCELLED
}

enum PaymentCreationStatus {
    NOT_REQUIRED
    NOT_STARTED
    CREATING
    READY
    UNKNOWN
    FAILED
}

model Payment {
    id            Int           @id @default(autoincrement())
    orderId       Int           @unique @map("order_id")
    order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
    paymentStatus PaymentStatus @map("payment_status")
    creationStatus PaymentCreationStatus @default(NOT_STARTED) @map("creation_status")
    amount        Decimal       @db.Decimal(12, 2)
    refundedAmount Decimal      @default(0) @map("refunded_amount") @db.Decimal(12, 2)

    transactionId String? @unique @map("transaction_id")
    confirmationUrl String? @map("confirmation_url")
    providerStatus String? @map("provider_status")
    creationStartedAt DateTime? @map("creation_started_at")
    lastError String? @map("last_error")

    paidAt DateTime? @map("paid_at")
    refundedAt DateTime? @map("refunded_at")

    @@index([orderId])
    @@index([paymentStatus, paidAt])
    @@index([paidAt])
    @@map("payment")
}
