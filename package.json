{
  "name": "protech",
  "description": "Production-ready Nuxt storefront and operations panel for ПроТех76.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "prisma:validate": "prisma validate --schema ./server/prisma",
    "prisma:generate": "prisma generate --schema ./server/prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ./server/prisma",
    "seed:admin": "tsx server/prisma/seed-admin.ts",
    "db:deploy": "npm run prisma:migrate:deploy && npm run seed:admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run",
    "check": "npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm run lint",
    "check:ci": "npm run check && npm run test && npm run build",
    "preview": "nuxt preview",
    "postinstall": "npm run prisma:generate && nuxt prepare"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1093.0",
    "@formkit/auto-animate": "0.10.0",
    "@lucide/vue": "1.24.0",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/ui": "4.10.0",
    "@nuxtjs/seo": "5.3.12",
    "@pinia/nuxt": "0.11.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tailwindcss/vite": "4.3.2",
    "@takumi-rs/core": "2.2.0",
    "@unhead/vue": "3.3.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vueuse/nuxt": "14.3.0",
    "better-auth": "1.6.27",
    "dotenv": "17.4.2",
    "eslint": "10.7.0",
    "nodemailer": "9.0.3",
    "nuxt": "4.5.2",
    "nuxt-og-image": "6.7.8",
    "pg": "8.22.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "unhead": "3.3.2",
    "vue": "3.5.41",
    "vue-sonner": "2.0.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.117",
